# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventflow_db?schema=public

# JWT Secrets
JWT_SECRET=super-secret-jwt-access-token-key-32-chars-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-token-key-32-chars-min
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BOOKING_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=15

# Business Rules
MAX_TICKETS_PER_BOOKING=5
CANCELLATION_DEADLINE_HOURS=2

# Redis Cache (Optional - leaves empty to use in-memory fallback)
# REDIS_URL=redis://localhost:6379
